    family-names: Pouresmaeeli
version: "0.1.0"
date-released: 2026-10-15
repository-code: "https://github.com/SalehPouresmaeeli/femur-fracture-classifier"
keywords:
  - hip fracture
  - femur
  - CT
  - machine learning
  - classification
